{
  "name": "Axioledger Monorepo — Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  // ──────────────────────────────────────────────
  // Công cụ bổ sung cài vào container
  // ──────────────────────────────────────────────
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "minimal"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // ──────────────────────────────────────────────
  // Lệnh chạy một lần sau khi container khởi tạo
  // Cài pnpm + dependencies → engineer vào là dùng được ngay
  // ──────────────────────────────────────────────
  "postCreateCommand": "npm install -g pnpm@9 && pnpm install --no-frozen-lockfile",

  // ──────────────────────────────────────────────
  // VS Code extensions tự động cài trong Codespace
  // ──────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "rust-lang.rust-analyzer",
        "golang.go",
        "GitHub.copilot",
        "GitHub.vscode-pull-request-github",
        "ms-vscode.vscode-typescript-next",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "eslint.workingDirectories": [{ "mode": "auto" }],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // ──────────────────────────────────────────────
  // Forward ports (dev servers)
  // ──────────────────────────────────────────────
  "forwardPorts": [3000, 4000, 8080],
  "portsAttributes": {
    "3000": { "label": "App (Next.js / Vite)", "onAutoForward": "openPreview" },
    "4000": { "label": "API Server",           "onAutoForward": "silent" },
    "8080": { "label": "Docs / Storybook",     "onAutoForward": "silent" }
  },

  // ──────────────────────────────────────────────
  // Biến môi trường trong Codespace
  // Secrets nhạy cảm (NPM_TOKEN, etc.) thiết lập trong
  // GitHub → Settings → Codespaces → Secrets — KHÔNG hardcode ở đây
  // ──────────────────────────────────────────────
  "remoteEnv": {
    "NODE_ENV": "development",
    "PNPM_HOME": "/usr/local/share/pnpm"
  }
}
