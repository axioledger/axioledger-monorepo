{
  "name": "@axioledger/docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "Axioledger Developer Documentation Site — SDK reference, tutorials, API explorer",
  "type": "module",
  "scripts": {
    "dev":       "vite",
    "build":     "tsc --noEmit && vite build",
    "preview":   "vite preview",
    "typecheck": "tsc --noEmit",
    "lint":      "eslint src --ext .ts,.tsx",
    "test":      "vitest run",
    "clean":     "rimraf dist"
  },
  "dependencies": {
    "axioledger":             "workspace:*",
    "@axioledger/ui-kit":     "workspace:*",
    "@axioledger/html":       "workspace:*"
  },
  "devDependencies": {
    "@axioledger/eslint-config":  "workspace:*",
    "@axioledger/tsconfig":       "workspace:*",
    "@types/react":               "^18.3.0",
    "@types/react-dom":           "^18.3.0",
    "@vitejs/plugin-react":       "^4.2.0",
    "react":                      "^18.3.0",
    "react-dom":                  "^18.3.0",
    "rimraf":                     "^5.0.0",
    "typescript":                 "^5.3.0",
    "vite":                       "^5.2.0",
    "vitest":                     "^1.4.0"
  },
  "keywords": ["axioledger", "docs", "documentation", "developer", "reference", "tutorials"]
}
