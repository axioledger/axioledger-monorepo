{
  "name": "axioledger",
  "version": "2.0.22",
  "private": true,
  "type": "module",
  "description": "Axioledger — Layer-1/Layer-2 Blockchain Ecosystem Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/axioledger/axioledger-monorepo"
  },
  "author": "Axioledger Foundation",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build":         "pnpm --recursive run build",
    "test":          "pnpm --recursive run test",
    "lint":          "pnpm --recursive run lint",
    "typecheck":     "pnpm --recursive run typecheck",
    "dev":           "pnpm --parallel --filter \"./apps/*\" run dev",
    "clean":         "pnpm --recursive run clean && rimraf node_modules",
    "changeset":     "changeset",
    "release":       "pnpm build && changeset publish",
    "info":          "node --print \"('$pkg' ? '@$npm_package_name/$pkg@' : '') + require('./${pkg:+packages/$pkg/}package').version\"",
    "setup:wsl":     "bash scripts/setup-wsl.sh",
    "check:links":   "node scripts/check-doc-links.js",
    "check:links:strict": "node scripts/check-doc-links.js --strict",
    "test:escrow":   "node node_modules/twist/bin/twist.js tests/escrow/TreasuryEscrowContract.test.js"
  },
  "dependencies": {
    "@hot-labs/kit":                 "1.6.4",
    "@hot-labs/omni-sdk":            "2.25.5",
    "@hot-labs/near-connect":        "0.11.4",
    "@solana/web3.js":               "1.98.4",
    "borsh":                         "2.0.0",
    "@cosmjs/stargate":              "0.32.4",
    "@cosmjs/proto-signing":         "0.32.4",
    "@cosmjs/encoding":              "0.32.4",
    "@cosmjs/tendermint-rpc":        "0.32.4",
    "@cosmjs/socket":                "0.32.4",
    "@cosmjs/crypto":                "0.32.4",
    "@cosmjs/amino":                 "0.32.4",
    "@cosmjs/math":                  "0.32.4",
    "@cosmjs/utils":                 "0.32.4",
    "@cosmjs/cosmwasm-stargate":     "0.32.4",
    "chain-registry":                "1.69.52",
    "@chain-registry/types":         "0.50.42",
    "@chain-registry/utils":         "1.51.9",
    "protobufjs":                    "7.4.0",
    "long":                          "5.2.3",
    "@cosmos-kit/core":              "2.18.1",
    "@noble/secp256k1":              "2.1.0",
    "@noble/hashes":                 "1.7.2",
    "@noble/curves":                 "1.8.2",
    "cosmjs-types":                  "0.9.0",
    "@simplewebauthn/browser":       "10.0.0",
    "bech32":                        "2.0.0",
    "bip39":                         "3.1.0"
  },
  "devDependencies": {
    "@changesets/cli":               "2.27.0",
    "@cosmology/telescope":          "1.12.0",
    "@cosmology/ast":                "1.9.0",
    "@cosmology/types":              "2.2.0",
    "@cosmwasm/ts-codegen":          "0.35.7",
    "@cosmjs/faucet-client":         "0.32.4",
    "rimraf":                        "5.0.10",
    "starshipjs":                    "3.0.0",
    "ts-proto":                      "2.2.0",
    "typescript":                    "5.5.4",
    "twist":                         "0.0.5",
    "c8":                            "10.1.2"
  },
  "pnpm": {
    "overrides": {
      "@hot-labs/kit":                "1.6.4",
      "@hot-labs/omni-sdk":           "2.25.5",
      "@hot-labs/near-connect":       "0.11.4",
      "@solana/web3.js":              "^1.98.4",
      "borsh":                        "^2.0.0",
      "bn.js":                        "^5.2.1",
      "@cosmjs/stargate":             "0.32.4",
      "@cosmjs/proto-signing":        "0.32.4",
      "@cosmjs/encoding":             "0.32.4",
      "@cosmjs/crypto":               "0.32.4",
      "@cosmjs/amino":                "0.32.4",
      "@cosmjs/math":                 "0.32.4",
      "@cosmjs/utils":                "0.32.4",
      "@cosmjs/tendermint-rpc":       "0.32.4",
      "@cosmjs/socket":               "0.32.4",
      "@cosmjs/cosmwasm-stargate":    "0.32.4",
      "@cosmos-kit/core":             "2.18.1",
      "cosmjs-types":                 "0.9.0"
    },
    "neverBuiltDependencies": [
      "bufferutil",
      "utf-8-validate",
      "node-gyp-build",
      "secp256k1",
      "keccak",
      "leveldown",
      "classic-level",
      "better-sqlite3"
    ]
  },
  "keywords": [
    "axioledger",
    "blockchain",
    "layer1",
    "layer2",
    "zk",
    "vdom",
    "web3",
    "monorepo"
  ]
}
