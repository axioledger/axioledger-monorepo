{
  "name": "@valiprecision/core-daemon",
  "version": "1.0.0",
  "description": "P2P Node Daemon cho Valiprecision Validator Network",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "require": "./dist/index.cjs", "types": "./dist/index.d.ts" } },
  "files": ["dist","src"],
  "license": "MIT",
  "scripts": { "build": "axio-build", "typecheck": "tsc --noEmit", "test": "vitest run", "clean": "rimraf dist" },
  "peerDependencies": {
    "@libp2p/interface": ">=1.0.0",
    "libp2p": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@libp2p/interface": { "optional": true },
    "libp2p": { "optional": true }
  },
  "devDependencies": { "@axioledger/build-scripts": "workspace:*", "@axioledger/tsconfig": "workspace:*", "typescript": "^5.3.0", "vitest": "^1.4.0" },
  "keywords": ["axioledger", "valiprecision", "p2p", "node", "validator", "daemon"]
}
