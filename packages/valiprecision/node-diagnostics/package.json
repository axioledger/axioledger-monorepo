{
  "name": "@valiprecision/node-diagnostics",
  "version": "1.0.0",
  "description": "Pre-flight Node Health Check cho Valiprecision",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "scripts": {
    "build": "axio-build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@valiprecision/core-daemon": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@valiprecision/core-daemon": {
      "optional": false
    }
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/tsconfig": "workspace:*",
    "@valiprecision/core-daemon": "workspace:*",
    "typescript": "^5.3.0",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "axioledger",
    "valiprecision",
    "diagnostics",
    "health",
    "metrics"
  ]
}
