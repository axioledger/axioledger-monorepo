{
  "name": "@kinetoprotocol/bridge-relayer",
  "version": "1.0.0",
  "description": "ZK-EVM Cross-Chain Bridge Relayer — lock-and-mint, ZK storage proofs, message relay & escape hatch",
  "type": "module",
  "main":   "./dist/index.cjs",
  "module": "./dist/index.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "test:watch":"vitest",
    "clean":     "rimraf dist"
  },
  "devDependencies": {
    "@axioledger/build-scripts":    "workspace:*",
    "@axioledger/tsconfig":         "workspace:*",
    "@kinetoprotocol/clamm-engine": "workspace:*",
    "typescript":                   "^5.3.0",
    "vitest":                       "^1.4.0"
  },
  "keywords": ["axioledger", "kinetoprotocol", "bridge", "cross-chain", "zk-evm", "relayer", "lock-mint"]
}
