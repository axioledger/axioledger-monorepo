{
  "name": "@kinetoprotocol/clamm-engine",
  "version": "1.0.0",
  "description": "Concentrated Liquidity AMM (CLAMM) engine — price range management, tick math & LP position accounting",
  "type": "module",
  "main":   "./dist/index.cjs",
  "module": "./dist/index.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "test:watch":"vitest",
    "clean":     "rimraf dist"
  },
  "dependencies": {
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/tsconfig":      "workspace:*",
    "@types/bn.js":              "^5.1.5",
    "typescript":                "^5.3.0",
    "vitest":                    "^1.4.0"
  },
  "keywords": ["axioledger", "kinetoprotocol", "clamm", "amm", "liquidity", "defi", "uniswap-v3"]
}
