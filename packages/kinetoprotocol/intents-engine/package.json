{
  "name": "@kinetoprotocol/intents-engine",
  "version": "1.0.0",
  "description": "NEAR Intents Engine — wrapper @hot-labs/omni-sdk cho Axioledger",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "scripts": {
    "build": "axio-build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@hot-labs/omni-sdk": ">=2.25.0"
  },
  "peerDependenciesMeta": {
    "@hot-labs/omni-sdk": { "optional": true }
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/tsconfig": "workspace:*",
    "@hot-labs/omni-sdk": "2.25.5",
    "typescript": "^5.3.0",
    "vitest": "^1.4.0"
  }
}
