{
  "name": "@axioledger/axioledger-adapter",
  "version": "1.0.0",
  "description": "axioledger → AXQ pattern adapter — bridges axioledger VDOM with Axioledger blockchain patterns",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "node --experimental-vm-modules node_modules/.bin/jest",
    "lint":      "eslint src --ext .ts",
    "clean":     "rimraf dist"
  },
  "peerDependencies": {
    "axioledger": "workspace:*"
  },
  "devDependencies": {
    "axioledger": "workspace:*",
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/eslint-config": "workspace:*",
    "@axioledger/tsconfig": "workspace:*",
    "typescript": "^5.3.0"
  },
  "keywords": ["axioledger", "adapter", "vdom", "blockchain", "axq"]
}
