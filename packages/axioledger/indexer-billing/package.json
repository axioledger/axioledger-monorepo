{
  "name": "@axioledger/indexer-billing",
  "version": "1.0.0",
  "description": "Axioledger Indexer Billing — metered on-chain $AXQ query fee collection for third-party subgraph/GraphQL operators",
  "type": "module",
  "main":   "./dist/index.cjs",
  "module": "./dist/index.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "scripts": {
    "build":      "axio-build",
    "dev":        "tsc --watch --noEmit",
    "typecheck":  "tsc --noEmit",
    "test":       "vitest run",
    "test:watch": "vitest",
    "clean":      "rimraf dist"
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/tsconfig":      "workspace:*",
    "typescript":                "^5.3.0",
    "vitest":                    "^1.4.0"
  },
  "keywords": [
    "axioledger", "indexer", "billing", "query-fees", "subgraph",
    "graphql", "axq", "metered", "on-chain"
  ]
}
