{
  "name": "@axioledger/wallet-connector",
  "version": "1.0.0",
  "description": "Wallet connector — WebAuthn Passkey + CosmJS + @hot-labs/near-connect for Axioledger DApps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "node --experimental-vm-modules node_modules/.bin/jest",
    "lint":      "eslint src --ext .ts",
    "clean":     "rimraf dist"
  },
  "dependencies": {
    "@cosmjs/stargate":        "^0.32.4",
    "@cosmjs/proto-signing":   "^0.32.4",
    "@cosmjs/crypto":          "^0.32.4",
    "@cosmjs/encoding":        "^0.32.4",
    "@noble/secp256k1":        "^2.1.0",
    "@simplewebauthn/browser": "^10.0.0"
  },
  "peerDependencies": {
    "@hot-labs/kit":          ">=1.6.0",
    "@hot-labs/near-connect": ">=0.11.0"
  },
  "peerDependenciesMeta": {
    "@hot-labs/kit":          { "optional": false },
    "@hot-labs/near-connect": { "optional": false }
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/eslint-config":  "workspace:*",
    "@axioledger/tsconfig":       "workspace:*",
    "@hot-labs/kit":              "1.6.4",
    "@hot-labs/near-connect":     "0.11.4",
    "@types/node":                "^20.0.0",
    "typescript":                 "^5.3.0"
  },
  "keywords": ["axioledger", "wallet", "near", "web3", "passkey", "webauthn", "cosmjs", "secp256k1"]
}
