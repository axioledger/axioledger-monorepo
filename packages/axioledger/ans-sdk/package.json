{
  "name": "@axioledger/ans-sdk",
  "version": "1.0.0",
  "description": "Axioledger Name Service (ANS) SDK — .axq domain resolution & registration client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "test:watch":"vitest",
    "lint":      "eslint src --ext .ts",
    "clean":     "rimraf dist"
  },
  "dependencies": {
    "borsh": "^2.0.0",
    "bn.js": "^5.2.1"
  },
  "peerDependencies": {
    "@solana/web3.js": ">=1.87.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": { "optional": false }
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/eslint-config":  "workspace:*",
    "@axioledger/tsconfig":       "workspace:*",
    "@solana/web3.js":            "^1.98.4",
    "@types/bn.js":               "^5.1.5",
    "typescript": "^5.3.0",
    "vitest": "^1.4.0"
  },
  "keywords": ["axioledger", "ans", "name-service", "solana", "svm", "borsh", "pda", "axq"]
}
