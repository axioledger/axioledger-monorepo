{
  "extends": "@axioledger/tsconfig/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir":  "dist",
    "declaration":    true,
    "declarationMap": true,
    "sourceMap":      true,
    "composite":      true,
    "moduleResolution": "bundler",
    "module":    "ESNext",
    "target":    "ES2022",
    "lib":       ["ES2022"],
    "strict":    true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
