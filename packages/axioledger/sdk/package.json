{
  "name": "@axioledger/sdk",
  "version": "2.0.22",
  "private": true,
  "description": "Axioledger TypeScript SDK — auto-generated Cosmos clients, 5-Token types, IBC bindings",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    },
    "./generated": {
      "import":  "./dist/generated/index.js",
      "require": "./dist/generated/index.cjs",
      "types":   "./dist/generated/index.d.ts"
    },
    "./client": {
      "import":  "./dist/generated/client.js",
      "require": "./dist/generated/client.cjs",
      "types":   "./dist/generated/client.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "codegen":   "bash ../../toolchain/build-scripts/generate-proto.sh",
    "clean":     "rimraf dist"
  },
  "dependencies": {
    "@cosmjs/stargate":        "^0.32.4",
    "@cosmjs/proto-signing":   "^0.32.4",
    "@cosmjs/encoding":        "^0.32.4",
    "@cosmjs/crypto":          "^0.32.4",
    "@cosmjs/amino":           "^0.32.4",
    "@cosmjs/math":            "^0.32.4",
    "@cosmjs/utils":           "^0.32.4",
    "@cosmjs/tendermint-rpc":  "^0.32.4",
    "cosmjs-types":            "^0.9.0",
    "protobufjs":              "^7.3.0",
    "long":                    "^5.2.3"
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/tsconfig":      "workspace:*",
    "@cosmology/telescope":      "^1.10.0",
    "typescript":                "^5.3.0",
    "vitest":                    "^2.0.0",
    "rimraf":                    "^5.0.0"
  },
  "keywords": ["axioledger", "sdk", "cosmos", "cosmjs", "ibc", "axq", "blockchain", "typescript"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url":  "https://github.com/axioledger/axioledger-monorepo"
  }
}
