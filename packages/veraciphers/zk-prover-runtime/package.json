{
  "name": "@veraciphers/zk-prover-runtime",
  "version": "1.0.0",
  "description": "Veraciphers ZK Prover Runtime — Halo2/PlonKy2 mobile-optimized proof generation engine (<100ms target), Docker-packaged for GPU cluster deployment",
  "type": "module",
  "main":   "./dist/index.cjs",
  "module": "./dist/index.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "Dockerfile", "docker-compose.yml"],
  "license": "MIT",
  "scripts": {
    "build":         "axio-build",
    "dev":           "tsc --watch --noEmit",
    "typecheck":     "tsc --noEmit",
    "test":          "vitest run",
    "test:watch":    "vitest",
    "clean":         "rimraf dist",
    "docker:build":  "docker build -t axioledger/zk-prover:latest .",
    "docker:run":    "docker run --rm --gpus all axioledger/zk-prover:latest"
  },
  "dependencies": {
    "@veraciphers/circuit-compiler": "workspace:*"
  },
  "devDependencies": {
    "@axioledger/build-scripts":    "workspace:*",
    "@axioledger/tsconfig":         "workspace:*",
    "@veraciphers/circuit-compiler": "workspace:*",
    "typescript":                   "^5.3.0",
    "vitest":                       "^1.4.0"
  },
  "keywords": [
    "axioledger", "veraciphers", "zk-prover", "halo2", "plonky2",
    "mobile", "gpu", "docker", "proof-generation"
  ]
}
