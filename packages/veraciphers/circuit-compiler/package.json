{
  "name": "@veraciphers/circuit-compiler",
  "version": "1.0.0",
  "description": "Veraciphers ZK Circuit Compiler — Halo2/PlonKy2 constraint system builder, witness generator & proof request dispatcher",
  "type": "module",
  "main":   "./dist/index.cjs",
  "module": "./dist/index.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "test:watch":"vitest",
    "clean":     "rimraf dist"
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/tsconfig":      "workspace:*",
    "typescript":                "^5.3.0",
    "vitest":                    "^1.4.0"
  },
  "keywords": ["axioledger", "veraciphers", "zk", "circuit", "halo2", "plonky2", "snark", "stark"]
}
