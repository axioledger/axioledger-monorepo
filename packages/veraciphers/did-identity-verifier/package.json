{
  "name": "@veraciphers/did-identity-verifier",
  "version": "1.0.0",
  "description": "Veraciphers DID Identity Verifier — ZK-DID Soulbound Tokens, selective disclosure proofs, MACI anti-collusion circuit, and NPM supply-chain checksum security",
  "type": "module",
  "main":   "./dist/index.cjs",
  "module": "./dist/index.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "scripts": {
    "build":      "axio-build",
    "dev":        "tsc --watch --noEmit",
    "typecheck":  "tsc --noEmit",
    "test":       "vitest run",
    "test:watch": "vitest",
    "clean":      "rimraf dist"
  },
  "dependencies": {
    "@veraciphers/circuit-compiler": "workspace:*",
    "@veraciphers/on-chain-verifier": "workspace:*"
  },
  "devDependencies": {
    "@axioledger/build-scripts":     "workspace:*",
    "@axioledger/tsconfig":          "workspace:*",
    "@veraciphers/circuit-compiler": "workspace:*",
    "@veraciphers/on-chain-verifier": "workspace:*",
    "typescript":                    "^5.3.0",
    "vitest":                        "^1.4.0"
  },
  "keywords": [
    "axioledger", "veraciphers", "zk-did", "did", "identity", "soulbound",
    "sbt", "maci", "selective-disclosure", "kyc", "compliance", "privacy"
  ]
}
