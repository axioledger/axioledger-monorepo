{
  "name": "@sequentichain/docker-runtime",
  "version": "1.0.0",
  "description": "Sequentichain Isolated Container Execution Environment — Docker-based L2 sequencer node runtime with AF_XDP acceleration support",
  "type": "module",
  "main":   "./dist/index.cjs",
  "module": "./dist/index.js",
  "types":  "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "Dockerfile", "docker-compose.yml"],
  "license": "MIT",
  "scripts": {
    "build":     "axio-build",
    "dev":       "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "clean":     "rimraf dist",
    "docker:build": "docker build -t axioledger/sequencer:latest .",
    "docker:run":   "docker run --rm --network=host axioledger/sequencer:latest"
  },
  "dependencies": {
    "@sequentichain/sequencer-node":  "workspace:*",
    "@sequentichain/async-task-runner": "workspace:*"
  },
  "devDependencies": {
    "@axioledger/build-scripts": "workspace:*",
    "@axioledger/tsconfig":      "workspace:*",
    "typescript":                "^5.3.0",
    "vitest":                    "^1.4.0"
  },
  "keywords": [
    "axioledger", "sequentichain", "docker", "container", "runtime",
    "sequencer", "l2", "af-xdp", "isolated-execution"
  ]
}
